<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qrb_hcm_ipc_adapter</name>
  <version>0.2.0</version>
  <description>
    HCM IPC Adapter of qrb_ros_adapter: a synchronous QCNode that exchanges
    qrb_contracts messages with the ROS IPC Bridge over the IPC Runtime. Does
    not depend on ROS.
  </description>
  <maintainer email="noreply@qualcomm.com">Qualcomm Technologies, Inc.</maintainer>
  <license>BSD-3-Clause-Clear</license>

  <buildtool_depend>cmake</buildtool_depend>

  <depend>qrb_ros_adapter_runtime</depend>
  <depend>nlohmann-json-dev</depend>

  <test_depend>gtest</test_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
