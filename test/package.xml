<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qrb_ros_adapter_stream_probe</name>
  <version>0.2.0</version>
  <description>
    End-to-end test of qrb_ros_adapter: probe nodes on the HCM and ROS sides send or receive and check frames
    through the HCM IPC Adapter and the ROS IPC Bridge, with loss, order and latency statistics.
  </description>
  <maintainer email="noreply@qualcomm.com">Qualcomm Technologies, Inc.</maintainer>
  <license>BSD-3-Clause-Clear</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>qrb_ros_transport_point_cloud2_type</depend>
  <depend>qrb_ros_adapter</depend>
  <depend>qrb_hcm_ipc_adapter</depend>
  <build_depend>nlohmann-json-dev</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
